{
  "name": "@cospho/catalog",
  "version": "0.0.0",
  "private": true,
  "description": "Cospho site catalog: collections, events, and Flickr orchestration",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": "22.22.2"
  },
  "scripts": {
    "oauth-init": "node --env-file=../../.env scripts/oauth-init.js",
    "list-collections": "node --env-file=../../.env scripts/list-collections.js",
    "list-photos": "node --env-file=../../.env scripts/list-photos.js",
    "generate-sprite": "node --env-file=../../.env scripts/generate-sprite.js",
    "generate-html": "node --env-file=../../.env scripts/generate-html.js",
    "build-index": "node --env-file=../../.env scripts/build-index.js",
    "rebuild-docs": "bash scripts/rebuild-docs.sh"
  },
  "dependencies": {
    "@cospho/gallery": "workspace:*",
    "flickr-sdk": "^7.1.0",
    "sharp": "^0.33.0"
  }
}
